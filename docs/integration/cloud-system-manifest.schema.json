{
  "$id": "https://github.com/Alejo2075/aws-cloud-agent/docs/integration/cloud-system-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "const": "CloudSystemManifest"
    },
    "system": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "const": "aws"
          },
          "accountId": {
            "type": "string",
            "pattern": "^\\d{12}$"
          },
          "region": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[a-z]+)+-\\d$"
          },
          "stacks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resources": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "logicalId": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["logicalId", "type"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "provider", "accountId", "region", "stacks", "resources"],
        "additionalProperties": false
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "iac": {
          "type": "string"
        },
        "artifactRef": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "kind", "system", "environments"],
  "additionalProperties": false
}
